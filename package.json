{
  "name": "harbor",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://spartan-native.github.io/harbor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spartan-Native/harbor.git"
  },
  "description": "Harbor Backup: the Spartan Native sample app, in the browser and as a desktop app (Wails).",
  "scripts": {
    "ng": "ng",
    "start": "ng serve harbor-backup",
    "build": "ng build harbor-backup",
    "test": "ng test harbor-backup --watch=false",
    "storybook": "ng run harbor-backup:storybook",
    "build-storybook": "ng run harbor-backup:build-storybook",
    "test:visual": "ng run harbor-backup:build-storybook && playwright test",
    "test:report": "npx playwright show-report dist/playwright-report",
    "build:site": "node scripts/build-site.mjs",
    "build:site:demo": "ng build harbor-backup --base-href /harbor/demo/ && node scripts/build-site.mjs --demo",
    "build:desktop:wails": "node desktop/wails/scripts/build.mjs",
    "start:desktop:wails": "node desktop/wails/scripts/build.mjs --run"
  },
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@ng-icons/core": "^33.4.0",
    "@ng-icons/lucide": "^33.4.0",
    "@spartan-native/desktop-ui": "^0.2.0",
    "@spartan-native/helm": "^0.2.0",
    "@spartan-native/host-wails": "^0.2.0",
    "@spartan-native/host-web": "^0.2.0",
    "@spartan-native/theme": "^0.2.0",
    "@spartan-ng/brain": "^1.9.0",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "@wailsio/runtime": "^3.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.0",
    "@spartan-ng/cli": "^1.9.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/angular": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
