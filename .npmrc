engine-strict=true
# The @spartan-native/* packages come from GitHub Packages (needs a token with read:packages,
# e.g. in ~/.npmrc: //npm.pkg.github.com/:_authToken=<token>).
@spartan-native:registry=https://npm.pkg.github.com
# Storybook 10.6 loads .storybook/main.ts via module.register(), which Node 26 deprecates
# (DEP0205). Silence only that code until Storybook moves to module.registerHooks().
node-options=--disable-warning=DEP0205
