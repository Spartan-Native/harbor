{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "projects": {
    "harbor-backup": {
      "projectType": "application",
      "schematics": {},
      "root": "app",
      "sourceRoot": "app/src",
      "prefix": "sn",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "app/src/main.ts",
            "tsConfig": "app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "app/public"
              }
            ],
            "styles": [
              "app/src/styles.css",
              "app/src/theme.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "app/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "harbor-backup:build:production"
            },
            "development": {
              "buildTarget": "harbor-backup:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "app/.storybook",
            "browserTarget": "harbor-backup:build",
            "tsConfig": "app/.storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "app/src/styles.css",
              "app/src/theme.scss"
            ],
            "port": 6010
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "app/.storybook",
            "browserTarget": "harbor-backup:build",
            "tsConfig": "app/.storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "app/src/styles.css",
              "app/src/theme.scss"
            ],
            "outputDir": "dist/storybook/harbor-backup"
          }
        }
      },
      "test": {
        "builder": "@angular/build:unit-test",
        "options": {
          "tsConfig": "app/tsconfig.spec.json"
        }
      }
    }
  }
}
